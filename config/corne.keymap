/*
 * CAPAS: 0 base | 1 nav+numeros+simbolos (MO1) | 2 puntero+multimedia (MO2) | 3 mouse lento
 * COMBOS: E+R=- | R+T=maximizar | U+I=+ | O+P=redo | A+S=TAB | D+F=2 | J+K=RET | L+BSPC=undo
 *         C+V=CAPS | V+B=cerrar ventana | ESC+SHFT+CTRL=bloquear pantalla
 *         ,+.+/+RET=apagar (HYPER+F13 -> Karabiner) | :+DEL+RET=BT_CLR
 * MO1 pares (base / shift): Q=¡ /!  W=[ /]  E=¿ /?  R=( /)
 * MO2: I/J/K/L mueven | D=click der | F=click izq | G=click medio
 *      A=scroll abajo S=scroll arriba | Z=scroll izq X=scroll der
 *      Q/W=brillo -/+ | E/R=volumen -/+ | SPC=mouse lento
 *      el resto de MO2 es &none (requiere CONFIG_ZMK_POINTING=y)
 */
#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#define ZMK_POINTING_DEFAULT_MOVE_VAL 450
#define ZMK_POINTING_DEFAULT_SCRL_VAL 20
#include <dt-bindings/zmk/pointing.h>
/ {
    behaviors {
        colon_semi: colon_semi {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp LS(SEMI)>, <&kp SEMI>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };
        comma_dquote: comma_dquote {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp COMMA>, <&kp LS(SQT)>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };
        morph_excl: morph_excl {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp LA(N1)>, <&kp EXCL>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };
        morph_brkt: morph_brkt {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp LBKT>, <&kp RBKT>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };
        morph_qmark: morph_qmark {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp LA(N2)>, <&kp QMARK>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };
        morph_paren: morph_paren {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp LPAR>, <&kp RPAR>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };
    };
    combos {
        compatible = "zmk,combos";
        combo_minus_er   { timeout-ms = <50>; key-positions = <3 4>;         bindings = <&kp MINUS>; };
        combo_fullscreen { timeout-ms = <50>; key-positions = <4 5>;         bindings = <&kp LC(LG(F))>; };
        combo_plus_ui    { timeout-ms = <50>; key-positions = <7 8>;         bindings = <&kp PLUS>; };
        combo_redo       { timeout-ms = <50>; key-positions = <9 10>;        bindings = <&kp LG(LS(Z))>; };
        combo_tab        { timeout-ms = <50>; key-positions = <13 14>;       bindings = <&kp TAB>; };
        combo_two        { timeout-ms = <50>; key-positions = <15 16>;       bindings = <&kp N2>; };
        combo_enter_jk   { timeout-ms = <50>; key-positions = <19 20>;       bindings = <&kp RET>; };
        combo_undo       { timeout-ms = <50>; key-positions = <21 22>;       bindings = <&kp LG(Z)>; };
        combo_caps       { timeout-ms = <50>; key-positions = <27 28>;       bindings = <&kp CAPS>; };
        combo_close_win  { timeout-ms = <50>; key-positions = <28 29>;       bindings = <&kp LG(W)>; };
        combo_lock       { timeout-ms = <50>; key-positions = <0 12 24>;     bindings = <&kp LC(LG(Q))>; };
        combo_shutdown   { timeout-ms = <50>; key-positions = <32 33 34 35>; bindings = <&kp LS(LA(LC(LG(F13))))>; };
        combo_bt_clr     { timeout-ms = <50>; key-positions = <11 23 35>;    bindings = <&bt BT_CLR_ALL>; };
    };
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp ESC    &kp Q  &kp W  &kp E  &kp R  &kp T       &kp Y  &kp U  &kp I          &kp O    &kp P     &colon_semi
&kp LSFT   &kp A  &kp S  &kp D  &kp F  &kp G       &kp H  &kp J  &kp K          &kp L    &kp BSPC  &kp DEL
&kp LCTRL  &kp Z  &kp X  &kp C  &kp V  &kp B       &kp N  &kp M  &comma_dquote  &kp DOT  &kp FSLH  &kp RET
                         &mo 2  &kp LALT  &kp LGUI       &kp LS(LA(LC(LGUI)))  &kp SPACE  &mo 1
            >;
        };

        nav_layer {
            bindings = <
&trans  &morph_excl  &morph_brkt  &morph_qmark  &morph_paren  &kp PIPE    &kp AMPS  &kp AT     &kp UP     &kp EQUAL  &kp PRCNT  &trans
&trans  &kp N0       &kp N1       &kp N2        &kp N3        &kp N4      &kp HASH  &kp LEFT   &kp DOWN   &kp RIGHT  &kp STAR   &kp TILDE
&trans  &kp N5       &kp N6       &kp N7        &kp N8        &kp N9      &kp DLLR  &kp PG_UP  &kp PG_DN  &kp UNDER  &kp BSLH   &trans
                                  &trans  &trans  &trans                  &trans  &trans  &trans
            >;
        };

        mouse_layer {
            bindings = <
&none   &kp F1          &kp F2           &kp F11    &kp F12    &none        &none  &none           &mmv MOVE_UP    &none            &none  &none
&trans  &msc SCRL_DOWN  &msc SCRL_UP     &mkp RCLK  &mkp LCLK  &mkp MCLK    &none  &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_RIGHT  &none  &none
&trans  &msc SCRL_LEFT  &msc SCRL_RIGHT  &none      &none      &none        &none  &none           &none           &none            &none  &none
                                         &trans  &trans  &trans             &trans  &mo 3  &none
            >;
        };

        slow_mouse_layer {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
                        &trans  &trans  &trans    &trans  &trans  &trans
            >;
        };
    };
};

&mmv {
    time-to-max-speed-ms = <40>;
    acceleration-exponent = <0>;
};

&msc {
    time-to-max-speed-ms = <40>;
    acceleration-exponent = <0>;
};

/* capa 3 activa -> el movimiento del puntero se divide por 4 */
&mmv_input_listener {
    slow_mode {
        layers = <3>;
        input-processors = <&zip_xy_scaler 1 4>;
    };
};
